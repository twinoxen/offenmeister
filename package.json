{
  "name": "offenmeister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offenmeister — learn languages by filling in the blank, in context, with spaced repetition.",
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "dev:convex": "convex dev",
    "build": "nuxt build",
