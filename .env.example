# Copy to .env.local. Most values are written automatically by `npx convex dev`.

# Convex deployment + client URL (set by `npx convex dev`).
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Public URL of the Nuxt app — used by Better Auth for trusted origins.
SITE_URL=http://localhost:3000

# --- Set on the Convex deployment (NOT here), via `npx convex env set NAME value` ---
# BETTER_AUTH_SECRET   Random secret: `openssl rand -base64 32`
# SITE_URL             Same as above (http://localhost:3000 in dev)
# ANTHROPIC_API_KEY    Optional — enables the on-demand "✨ Explain" AI feature
# AI_MODEL             Optional — defaults to claude-haiku-4-5-20251001
